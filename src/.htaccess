IndexIgnore # Prevent directory listing

# Block access to sensitive files
<FilesMatch "\.(log|sql|md|json|ya?ml)$">
    Require all denied
</FilesMatch>

# Credentials written by the deploy pipeline. PHP never serves these as source,
# but if the PHP handler ever fails they would be readable as plain text.
<FilesMatch "^config\.local\.php$">
    Require all denied
</FilesMatch>

RewriteEngine on
DirectoryIndex index.php

ErrorDocument 404 /404.php

# Externally redirect well-known page URLs to remove .php extension ONLY for initial HTML requests.
# IMPORTANT: Do NOT match game-state.php or other API URLs used by AJAX POST calls.
# Only strip .php from page entry points (index, viewer, admin-view, eingabe).
RewriteCond %{THE_REQUEST} \s/(index|viewer|admin-view|eingabe|playlist-info|logout|404|oauth)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NC]

# Internally serve the .php file when extension is omitted for GET requests that didn't match above.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^ %{REQUEST_URI}.php [L]
